            font-weight: bold;

            transition: 0.3s;
        }


        .nav-links a:hover {

            color:
                var(--gold-light);

            background:
                rgba(201,162,39,0.12);

            transform:
                translateY(-2px);
        }


        .nav-whatsapp {

            background:
                linear-gradient(
                    145deg,
                    #F6E7A8,
                    #C9A227,
                    #9C7812
                ) !important;

            color:
                var(--navy) !important;

            box-shadow:
                0 4px 0 #72550B,
                0 8px 15px
                rgba(0,0,0,0.3);
        }


        /* =========================
           HERO
        ========================= */

        header {

            min-height: 650px;

            display: flex;

            align-items: center;

            justify-content: center;

            text-align: center;

            padding:
                80px 20px;

            position: relative;

            overflow: hidden;

            background:

                radial-gradient(
                    circle at 20% 20%,
                    rgba(201,162,39,0.20),
                    transparent 30%
                ),

                radial-gradient(
                    circle at 80% 80%,
                    rgba(110,31,50,0.40),
                    transparent 35%
                ),

                linear-gradient(
                    135deg,
                    #061521,
                    #102A43,
                    #4A1422,
                    #071A2B
                );

            border-bottom:
                5px solid var(--gold);

            box-shadow:
                0 20px 60px
                rgba(0,0,0,0.35);
        }


        header::before {

            content: "";

            position: absolute;

            width: 380px;

            height: 380px;

            border-radius: 50%;

            border:
                2px solid
                rgba(201,162,39,0.25);

            top: -170px;

            right: -100px;

            box-shadow:
                0 0 60px
                rgba(201,162,39,0.15);
        }


        header::after {

            content: "";

            position: absolute;

            width: 280px;

            height: 280px;

            border-radius: 50%;

            border:
                2px solid
                rgba(255,255,255,0.08);

            bottom: -150px;

            left: -100px;
        }


        .hero {

            position: relative;

            z-index: 2;

            max-width: 950px;
        }


        .badge {

            display: inline-block;

            padding:
                10px 20px;

            border:
                1px solid
                rgba(246,231,168,0.5);

            border-radius: 50px;

            color:
                var(--gold-light);

            background:
                rgba(255,255,255,0.06);

            backdrop-filter:
                blur(10px);

            font-size: 13px;

            letter-spacing: 2px;

            margin-bottom: 25px;
        }


        /* =========================
           SNB HERO LOGO
        ========================= */

        .hero-logo {

            font-size:
                clamp(
                    70px,
                    15vw,
                    150px
                );

            font-weight: 900;

            letter-spacing: 10px;

            line-height: 1;

            color:
                #F6E7A8;

            background:
                linear-gradient(
                    180deg,
                    #FFF9D6 0%,
                    #F6E7A8 25%,
                    #C9A227 55%,
                    #8C6B10 100%
                );

            -webkit-background-clip:
                text;

            -webkit-text-fill-color:
                transparent;

            text-shadow:

                0 3px 0 #72550B,

                0 7px 0 #5A4308,

                0 12px 25px
                rgba(0,0,0,0.8);

            margin-bottom: 20px;

            animation:
                logoGlow 3s
                ease-in-out
                infinite;
        }


        @keyframes logoGlow {

            0%,
            100% {

                filter:
                    drop-shadow(
                        0 0 5px
                        rgba(201,162,39,0.25)
                    );
            }


            50% {

                filter:
                    drop-shadow(
                        0 0 22px
                        rgba(201,162,39,0.7)
                    );
            }
        }


        .hero h1 {

            color:
                var(--gold-light);

            font-size:
                clamp(
                    24px,
                    5vw,
                    45px
                );

            letter-spacing:
                3px;

            margin-bottom:
                12px;
        }


        .hero p {

            color:
                #E8EEF3;

            font-size:
                19px;

            margin:
                8px 0;
        }


        .hero-sub {

            color:
                var(--gold-light) !important;

            font-weight:
                bold;

            letter-spacing:
                1px;
        }


