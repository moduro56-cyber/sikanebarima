    >

    <style>

        :root {
            --navy: #071A2B;
            --navy2: #102A43;
            --navy3: #030D16;

            --burgundy: #6E1F32;
            --burgundy-dark: #3B0D1A;

            --gold: #C9A227;
            --gold-light: #F6E7A8;
            --gold-dark: #8C6B10;

            --white: #FFFFFF;
            --cream: #F8F5F0;

            --text: #243447;
            --muted: #667788;
        }


        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            scroll-behavior: smooth;
        }


        body {

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            background:
                linear-gradient(
                    135deg,
                    #F8F5F0,
                    #FFFFFF
                );

            color: var(--text);

            line-height: 1.6;
        }


        /* =========================
           NAVIGATION
        ========================= */

        .navbar {

            position: sticky;

            top: 0;

            z-index: 9999;

            background:
                linear-gradient(
                    135deg,
                    #030D16,
                    #071A2B,
                    #3B0D1A
                );

            border-bottom:
                2px solid var(--gold);

            box-shadow:
                0 8px 25px
                rgba(0,0,0,0.35);
        }


        .nav-container {

            max-width: 1250px;

            margin: auto;

            min-height: 78px;

            padding:
                10px 20px;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;
        }


        /* =========================
           SNB LOGO
        ========================= */

        .brand {

            display: flex;

            align-items: center;

            gap: 12px;

            text-decoration: none;
        }


        .snb-logo {

            width: 55px;

            height: 55px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 14px;

            font-size: 23px;

            font-weight: 900;

            letter-spacing: 1px;

            color: var(--navy);

            background:
                linear-gradient(
                    145deg,
                    #FFF9D6,
                    #F6E7A8,
                    #C9A227,
                    #8C6B10
                );

            border:
                2px solid
                var(--gold-light);

            box-shadow:

                0 5px 0
                #72550B,

                0 10px 25px
                rgba(0,0,0,0.4),

                inset 0 2px 2px
                rgba(255,255,255,0.8);
        }


        .brand-text strong {

            display: block;

            color:
                var(--gold-light);

            font-size: 16px;

            letter-spacing: 1.5px;
        }


        .brand-text small {

            display: block;

            color:
                #DCE5EC;

            font-size: 10px;

            letter-spacing: 1px;
        }


