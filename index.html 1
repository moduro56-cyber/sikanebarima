        ========================= */

        .about-highlight {

            margin-top:
                35px;

            display:
                grid;

            grid-template-columns:
                repeat(
                    auto-fit,
                    minmax(
                        200px,
                        1fr
                    )
                );

            gap:
                20px;
        }


        .about-card {

            padding:
                25px;

            border-radius:
                15px;

            background:
                white;

            border:
                1px solid
                rgba(201,162,39,0.25);

            box-shadow:
                0 15px 35px
                rgba(0,0,0,0.08);
        }


        .about-card strong {

            display:
                block;

            color:
                var(--burgundy);

            font-size:
                19px;

            margin-bottom:
                5px;
