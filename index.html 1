            margin-bottom:
                15px;
        }


        /* =========================
           CREDENTIAL
        ========================= */

        .credential {

            margin-top:
                30px;

            padding:
                25px;

            border-radius:
                16px;

            background:
                linear-gradient(
                    135deg,
                    #071A2B,
                    #102A43,
                    #3B0D1A
                );

            color:
                white;

            border:
                1px solid
                rgba(246,231,168,0.35);

            box-shadow:
                0 15px 35px
                rgba(0,0,0,0.2);
        }


        .credential .seal {

            font-size:
                38px;

            margin-bottom:
                10px;
        }


        .credential strong {

            display:
                block;

            color:
                var(--gold-light);

