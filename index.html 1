            box-shadow:

                0 10px 20px
                rgba(0,0,0,0.08),

                0 25px 50px
                rgba(0,0,0,0.08);

            transition:
                0.35s;
        }


        .service::before {

            content:
                "";

            position:
                absolute;

            top:
                0;

            left:
                0;

            width:
                100%;

            height:
                6px;

            background:
                linear-gradient(
                    90deg,
                    var(--burgundy),
                    var(--gold),
                    var(--burgundy)
                );
        }


        .service:hover {

            transform:
                translateY(-10px);

            box-shadow:

                0 20px 30px
                rgba(0,0,0,0.12),

                0 35px 70px
                rgba(0,0,0,0.15);
        }


        .service-icon {

            width:
                65px;

            height:
                65px;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            margin-bottom:
                20px;

            border-radius:
                15px;

            font-size:
                30px;

            background:
                linear-gradient(
                    145deg,
                    var(--burgundy),
                    var(--burgundy-dark)
                );

            color:
                var(--gold-light);

            box-shadow:

                0 7px 0 #2A0912,

                0 15px 25px
                rgba(59,13,26,0.3);
        }


        .service h3 {

            color:
                var(--burgundy);

            font-size:
                21px;

            margin-bottom:
                10px;
        }


        .service p {

            color:
                #596B7A;

            margin-bottom:
                10px;
        }


        .processing {

            color:
                var(--navy) !important;

            font-weight:
                bold;

            font-size:
                13px;
        }


        .service-btn {

            display:
                inline-block;

            margin-top:
                15px;

            padding:
                11px 17px;

            border-radius:
                8px;

            text-decoration:
                none;

            font-size:
                13px;

            font-weight:
                bold;

            color:
                white;

            background:
                linear-gradient(
                    145deg,
                    #8B2942,
                    #6E1F32,
                    #3B0D1A
