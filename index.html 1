            background:
                linear-gradient(
                    145deg,
                    #8B2942,
                    #6E1F32,
                    #3B0D1A
                );

            color:
                white;

            border:
                1px solid
                rgba(255,255,255,0.2);
        }


        /* =========================
           SECTION TITLES
        ========================= */

        .section-title {

