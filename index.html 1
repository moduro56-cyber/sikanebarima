                20px;
        }


        .about-intro {

            max-width:
                850px;

            margin:
                auto;

            font-size:
                18px;

            color:
                #596B7A;
        }


        .bio-box {

            margin-top:
                35px;

            padding:
                35px;

            border-radius:
                20px;

            background:
                linear-gradient(
                    145deg,
                    #FFFFFF,
                    #F8F5F0
                );

            border:
                2px solid
                rgba(201,162,39,0.35);

            box-shadow:

                0 15px 40px
                rgba(0,0,0,0.1);
        }


        .bio-box h3 {

            color:
